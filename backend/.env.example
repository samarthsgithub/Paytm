# Copy to .env for local development. Never commit the real file.
NODE_ENV=development
PORT=3000
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/payzip
# Local replica set (docker compose up mongo): mongodb://localhost:27017/payzip?directConnection=true
MONGO_URI=mongodb://localhost:27017/payzip?directConnection=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
